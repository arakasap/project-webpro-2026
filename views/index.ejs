<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= shopName %></title>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/customer-ui.css">
</head>

<body>
    <div class="container">
        <header class="customer-header home-header">
            <a class="home-brand" href="/" aria-label="หน้าแรก <%= shopName %>"><%= shopName %><span>สั่งอาหารที่โต๊ะ</span></a>
            <span class="customer-pill">โต๊ะ <%= sessionId %></span>
        </header>

        <% if (featuredItem && featuredItem.image_url) { %>
            <section class="featured-food" aria-label="เมนูจากร้าน">
                <img src="<%= featuredItem.image_url %>" alt="<%= featuredItem.name %>" class="featured-food-image" onerror="this.closest('.featured-food').hidden=true">
                <div class="featured-food-copy">
                    <span>จากเมนูของร้าน</span>
                    <strong><%= featuredItem.name %></strong>
                </div>
            </section>
        <% } %>

        <section class="welcome-copy">
            <h1 class="customer-page-title">เริ่มสั่งอาหาร</h1>
            <p class="customer-page-subtitle">ใส่ชื่อเล่นหรือเลือกชื่อเดิม เพื่อเริ่มรายการของคุณ</p>
        </section>

        <form action="/join-session" method="POST" id="joinForm">
            <input type="hidden" name="session_id" value="<%= sessionId %>">
            <input type="hidden" name="user_id" id="userIdInput">

            <% if (existingUsers && existingUsers.length > 0) { %>
                <div class="field-label-row">
                    <label class="field-label" for="nameInput">ชื่อเล่น</label>
                    <span class="field-hint">เลือกชื่อเดิมหรือพิมพ์ชื่อใหม่</span>
                </div>
            <% } else { %>
                <label class="field-label" for="nameInput">ชื่อเล่น</label>
            <% } %>

            <div class="input-group-wrapper">
                <input type="text" id="nameInput" name="name" class="input-field" placeholder="เช่น มะลิ" required autocomplete="off" oninput="handleInput()" onfocus="handleInput()" aria-controls="customDropdown" aria-autocomplete="list">
                <% if (existingUsers && existingUsers.length > 0) { %>
                    <div id="customDropdown" class="custom-dropdown-list" role="listbox" aria-label="สมาชิกในโต๊ะ">
                        <% existingUsers.forEach(u => { %>
                            <button type="button" class="custom-dropdown-item" data-name="<%= u.name %>" data-user-id="<%= u.user_id %>" role="option"><%= u.name %></button>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">เริ่มสั่งอาหาร</button>
        </form>

        <!-- <a class="order-status-link" href="/order-status?session_id=<%= encodeURIComponent(sessionId) %>">
            <span class="status-link-mark" aria-hidden="true"></span>
            <span><strong>ติดตามสถานะออร์เดอร์</strong><small>ดูรายการที่ส่งเข้าครัวแล้ว</small></span>
        </a> -->

        <footer class="home-footer">
            <button onclick="resetSystem()" class="reset-btn">ล้างข้อมูลระบบ (Reset)</button>
        </footer>
    </div>

    <script>
        // เก็บข้อมูล users จากฝั่ง Server ไว้ในตัวแปร JavaScript
        const existingUsers = <%- JSON.stringify(existingUsers || []) %>;

        function handleInput() {
            const inputVal = document.getElementById('nameInput').value.trim().toLowerCase();
            const dropdown = document.getElementById('customDropdown');
            const userIdInput = document.getElementById('userIdInput');
            const form = document.getElementById('joinForm');

            if (dropdown) {
                const filteredUsers = existingUsers.filter(u => u.name.toLowerCase().includes(inputVal));
                dropdown.replaceChildren();
                filteredUsers.forEach((user) => {
                    const option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'custom-dropdown-item';
                    option.setAttribute('role', 'option');
                    option.textContent = user.name;
                    option.addEventListener('click', () => selectUser(user.name, user.user_id));
                    dropdown.appendChild(option);
                });
                dropdown.style.display = filteredUsers.length ? 'block' : 'none';
            }

            // ตรวจสอบว่าเป็นชื่อเดิมเป๊ะๆ หรือไม่ เพื่อเปลี่ยน Action ของฟอร์ม
            const exactMatch = existingUsers.find(u => u.name.trim().toLowerCase() === inputVal);
            if (exactMatch) {
                userIdInput.value = exactMatch.user_id;
                form.action = `/menu?session_id=<%= sessionId %>&user_id=${exactMatch.user_id}`;
                form.method = 'GET';
            } else {
                userIdInput.value = '';
                form.action = '/join-session';
                form.method = 'POST';
            }
        }

        function selectUser(name, userId) {
            document.getElementById('nameInput').value = name;
            document.getElementById('userIdInput').value = userId;
            
            const form = document.getElementById('joinForm');
            form.action = `/menu?session_id=<%= sessionId %>&user_id=${userId}`;
            form.method = 'GET';

            const dropdown = document.getElementById('customDropdown');
            if (dropdown) dropdown.style.display = 'none';
        }

        // ซ่อน Dropdown เมื่อคลิกพื้นที่นอกฟอร์ม
        document.addEventListener('click', function(e) {
            const wrapper = document.querySelector('.input-group-wrapper');
            const dropdown = document.getElementById('customDropdown');
            if (wrapper && dropdown && !wrapper.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });

        async function resetSystem() {
            if (!confirm('คุณต้องการรีเซ็ตระบบและสร้าง Session ใหม่ใช่หรือไม่?')) return;

            try {
                const response = await fetch('/resetdatabase', { method: 'DELETE' });
                const result = await response.json();

                if (response.ok) {
                    alert('รีเซ็ตระบบเรียบร้อยแล้ว!');
                    window.location.href = `/?session_id=${result.new_session_id}`;
                } else {
                    alert('เกิดข้อผิดพลาด: ' + result.error);
                }
            } catch (err) {
                alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
            }
        }
    </script>
</body>

</html>