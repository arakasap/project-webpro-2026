<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สรุปรายการโต๊ะอาหาร - โต๊ะ <%= tableId %></title>
    <link rel="stylesheet" href="/css/cas-tab-detail.css">
    <link rel="stylesheet" href="/css/staff.css">
</head>
<body class="staff-ui staff-cashier">
    <header class="staff-topbar">
        <a class="staff-brand" href="/cashier">ไอทีม่วนแจ่ม <span>STAFF</span></a>
        <nav class="staff-nav" aria-label="เมนูพนักงาน">
        </nav>
    </header>
    <div class="summary-container">
        <header class="header-bar">
            <a href="/cashier" class="back-btn" title="ย้อนกลับ">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </a>
            <h1 class="page-title">สรุปรายการโต๊ะอาหาร (โต๊ะ <%= tableId %>)</h1>
            <div class="header-spacer"></div>
        </header>

        <main class="summary-content">
            <!-- คอลัมน์ซ้าย: รายการคำสั่งซื้อ -->
            <section class="order-section">
                <h2 class="section-title">รายการคำสั่งซื้อ</h2>
                <div class="order-list">
                    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                        <% orders.forEach(function(item) { %>
                            <div class="order-item">
                                <img src="<%= item.image_url || 'https://images.unsplash.com/photo-1540420773420-3366772f4999?w=150&auto=format&fit=crop' %>" alt="<%= item.name %>" class="food-img">
                                <div class="item-details">
                                    <div class="item-title-row">
                                        <span class="food-name"><%= item.name %> (<%= item.price %>.-)</span>
                                    </div>
                                    <div class="item-meta">
                                        <span class="meta-label">ผู้รับผิดชอบ</span>
                                        <div class="tags-group">
                                            <% if (item.tags && item.tags.length > 0) { %>
                                                <% item.tags.forEach(function(tag) { %>
                                                    <span class="tag-badge active"><%= tag %></span>
                                                <% }); %>
                                                <span class="tag-sub">(เฉลี่ยคนละ <%= item.splitPricePerPerson.toFixed(2) %>.-)</span>
                                            <% } else { %>
                                                <span class="tag-badge">ทานร่วมกันทุกคน</span>
                                                <span class="tag-sub">(เฉลี่ยคนละ <%= item.splitPricePerPerson.toFixed(2) %>.-)</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <div class="item-qty">x <%= item.quantity %></div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="padding: 40px; text-align: center; color: #64748b;">
                            ยังไม่มีรายการสั่งอาหารสำหรับโต๊ะนี้
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- คอลัมน์ขวา: คำนวณยอดเงินและปุ่มชำระเงิน -->
            <section class="payment-section">
                <div class="split-calculation-box">
                    <div class="split-title">สรุปยอดคำสั่งซื้อ</div>
                    <% if (typeof splitDetails !== 'undefined' && splitDetails.length > 0) { %>
                        <% splitDetails.forEach(function(detail) { %>
                            <div class="calc-line">
                                <span><strong><%= detail.name %></strong></span> 
                                <span><%= detail.calcString %></span>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="calc-line" style="justify-content: center; color: #94a3b8;">
                            <span>ยังไม่มีข้อมูลผู้ใช้งานในโต๊ะนี้</span>
                        </div>
                    <% } %>
                </div>

                <div class="bill-summary">
                    <div class="summary-row total-row">
                        <span class="label">ยอดรวมทั้งหมด</span>
                        <span class="value"><%= typeof totalPrice !== 'undefined' ? totalPrice.toFixed(2) : '0.00' %> บาท</span>
                    </div>

                    <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
                        <div class="payment-choice-group" aria-label="เลือกรูปแบบชำระเงิน">
                            <a class="payment-choice-btn split-choice" href="/cashier/table/<%= tableId %>/payment?mode=split">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="8" cy="5" r="2"/><circle cx="16" cy="12" r="2"/><circle cx="10" cy="19" r="2"/></svg>
                                <span><strong>หารตามข้อมูลผู้รับผิดชอบ</strong><small>สร้าง QR แยกตามยอดของแต่ละคน</small></span>
                            </a>
                            <a class="payment-choice-btn combined-choice" href="/cashier/table/<%= tableId %>/payment?mode=combined">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18l-2 12H5L3 7Z"/><path d="M8 7a4 4 0 0 1 8 0M8 12h8"/></svg>
                                <span><strong>จ่ายรวมทั้งโต๊ะ</strong><small>สร้าง QR ใบเดียวสำหรับยอดรวม</small></span>
                            </a>
                        </div>
                    <% } else { %>
                        <div class="payment-choice-group" aria-label="เลือกรูปแบบชำระเงิน">
                            <button class="payment-choice-btn" type="button" disabled>ยังไม่มีรายการสำหรับชำระเงิน</button>
                        </div>
                    <% } %>
                </div>
            </section>
        </main>
    </div>

    <!-- สคริปต์รีเฟรชหน้าอัตโนมัติทุกๆ 3 วินาที เพื่อดึงรายการสั่งอาหารใหม่ -->
    <script>
        setInterval(() => {
            window.location.reload();
        }, 3000);
    </script>
</body>
</html>