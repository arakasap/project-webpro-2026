<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สรุปรายการโต๊ะ <%= tableNo %></title>
    <link rel="stylesheet" href="/css/customer-ui.css">
    <link rel="stylesheet" href="/css/table-summary.css">
    <link rel="stylesheet" href="/css/customer-summary-ui.css">
</head>
<body>
    <main class="table-summary-page customer-summary-page">
        <header class="summary-page-header">
            <a class="summary-back-link" href="/menu?session_id=<%= encodeURIComponent(sessionId) %>&user_id=<%= encodeURIComponent(user.user_id) %>">‹ เมนู</a>
            <div class="summary-page-brand">
                <h1>สรุปรายการโต๊ะ</h1>
            </div>
            <span class="customer-pill">โต๊ะ <%= tableNo %></span>
        </header>

        <p class="table-total-line">ยอดรวมของโต๊ะ <strong>฿<%= Number(tableTotal || 0).toLocaleString(undefined, { maximumFractionDigits: 2 }) %></strong></p>

        <% if (typeof splitDetails !== 'undefined' && splitDetails.length > 0) { %>
            <div class="payer-sections" aria-label="สรุปว่าใครจ่ายค่าอะไรบ้าง">
                <% splitDetails.forEach((detail) => { %>
                    <section class="payer-section" aria-label="รายการของ <%= detail.name %>">
                        <header class="payer-section-heading">
                            <h2><%= detail.name %></h2>
                            <strong>฿<%= Number(detail.total || 0).toLocaleString(undefined, { maximumFractionDigits: 2 }) %></strong>
                        </header>
                        <% if (detail.items.length > 0) { %>
                            <ul class="payer-item-list">
                                <% detail.items.forEach((item) => { %>
                                    <li class="payer-item-row">
                                        <span><%= item.name %> <small>× <%= item.qty %></small></span>
                                        <strong>฿<%= Number(item.share || 0).toLocaleString(undefined, { maximumFractionDigits: 2 }) %></strong>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p class="payer-empty">ยังไม่มีรายการที่ต้องชำระ</p>
                        <% } %>
                    </section>
                <% }); %>
            </div>
        <% } %>

        <% if (items.length === 0) { %>
            <section class="summary-empty">
                <h2>ยังไม่มีรายการอาหาร</h2>
                <p>รายละเอียดการชำระจะแสดงเมื่อมีรายการอาหารในโต๊ะนี้</p>
            </section>
        <% } %>

    </main>
</body>
</html>
