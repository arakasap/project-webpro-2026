<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Kanit', Tahoma, sans-serif;
            background: linear-gradient(180deg, #f8fafc 0%, #edf1f6 100%);
            background-attachment: fixed;
            margin: 0;
            padding: 20px;
            color: #1e293b;
        }
        /* แท็บด้านข้าง: ครัว / ออเดอร์ที่ต้องทำ / อัพเดทสถานะ */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 190px;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            padding: 22px 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            box-shadow: 4px 0 14px rgba(0, 0, 0, 0.18);
        }
        .sidebar a {
            color: #cbd5e1;
            text-decoration: none;
            padding: 14px 16px;
            min-height: 48px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 12px;
            transition: background-color 0.2s, color 0.2s;
        }
        .sidebar a:hover { background-color: rgba(255, 255, 255, 0.08); color: #ffffff; }
        .sidebar a.active {
            background-color: #16a34a;
            color: #ffffff;
            box-shadow: 0 4px 10px rgba(22, 163, 74, 0.4);
        }
        .kitchen-container { max-width: 1200px; margin: 0 auto 0 210px; }
        @media (max-width: 700px) {
            .sidebar { position: static; width: auto; flex-direction: row; padding: 8px; border-radius: 14px; margin-bottom: 12px; }
            .sidebar a { flex: 1; text-align: center; font-size: 1rem; padding: 12px 4px; }
            .kitchen-container { margin-left: auto; }
        }
        .kitchen-header { text-align: center; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 3px solid #16a34a; }
        .kitchen-header h1 { margin: 0; font-size: 2rem; color: #0f172a; letter-spacing: 0.5px; text-wrap: balance; }
        .count-line { margin: 6px 0 0 0; font-size: 1rem; color: #64748b; }
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }
        @media (max-width: 600px) {
            .card-grid { grid-template-columns: 1fr; }
        }
        .order-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
            transition: transform 0.15s ease-out, border-color 0.15s ease-out;
            max-width: 500px;
        }
        .order-card:hover {
            transform: translateY(-2px);
            border-color: #cbd5e1;
        }
        /* สีพื้นบอกสถานะบิล (พื้น tint ทั้งใบ ไม่ใช่แถบข้าง) */
        .order-card.acc-new { background-color: #f6fef9; }
        .order-card.acc-cook { background-color: #f5f9ff; }
        .order-card.acc-serve { background-color: #f2fafd; }
        .order-card.cancelled { background-color: #f8fafc; opacity: 0.8; }
        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 8px;
            border-bottom: 1px solid #eef2f7;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }
        .bill-meta { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
        .bill-sequence, .status-order-ref {
            flex: 0 0 auto;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }
        .bill-sequence { padding: 2px 6px; border: 1px solid #e2e8f0; border-radius: 4px; }
        .table-name { font-size: 1.45rem; font-weight: bold; color: #0f172a; }
        .order-time { font-size: 0.95rem; color: #64748b; white-space: nowrap; }
        .dish { padding: 7px 0; font-size: 1.15rem; }
        .dish-row-line { display: flex; justify-content: space-between; gap: 8px; }
        .dish-note {
            display: block;
            color: #dc2626;
            font-style: italic;
            font-size: 1rem;
            word-break: break-word;
            background-color: #fef2f2;
            border-radius: 8px;
            padding: 4px 8px;
            margin-top: 4px;
        }
        .cancel-note {
            display: block;
            color: #991b1b;
            font-weight: bold;
            font-size: 1rem;
            word-break: break-word;
            margin-top: 6px;
            background-color: #fee2e2;
            border-radius: 8px;
            padding: 6px 8px;
        }
        .bill-total {
            display: flex;
            justify-content: space-between;
            background-color: #f8fafc;
            border-radius: 10px;
            margin-top: 10px;
            padding: 10px 12px;
            font-size: 1.25rem;
            font-weight: bold;
            color: #0f172a;
        }
        .btn-accept {
            width: 100%;
            margin-top: 12px;
            min-height: 48px;
            font-size: 1.15rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(22, 163, 74, 0.35);
            transition: transform 0.1s, background-color 0.2s;
        }
        .btn-accept:hover { background-color: #15803d; }
        .btn-accept:active { transform: scale(0.98); }
        .btn-accept:disabled { background-color: #94a3b8; cursor: default; box-shadow: none; }
        .btn-link {
            display: block;
            padding: 0px;
            text-align: center;
            margin-top: 12px;
            min-height: 48px;
            font-size: 1.15rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #2563eb;
            border-radius: 12px;
            text-decoration: none;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.35);
            transition: transform 0.1s, background-color 0.2s;
        }
        .btn-link:hover { background-color: #1d4ed8; }
        .btn-link:active { transform: scale(0.98); }
        .btn-done {
            width: 100%;
            margin-top: 12px;
            min-height: 48px;
            font-size: 1.15rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(22, 163, 74, 0.35);
            transition: transform 0.1s, background-color 0.2s;
        }
        .btn-done:hover { background-color: #15803d; }
        .btn-done:active { transform: scale(0.98); }
        .btn-done:disabled { background-color: #94a3b8; cursor: default; box-shadow: none; }
        .btn-serve {
            width: 100%;
            margin-top: 8px;
            min-height: 48px;
            font-size: 1.05rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #0284c7;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(2, 132, 199, 0.35);
            transition: transform 0.1s, background-color 0.2s;
        }
        .btn-serve:hover { background-color: #0369a1; }
        .btn-serve:active { transform: scale(0.98); }
        .btn-serve:disabled { background-color: #94a3b8; cursor: default; box-shadow: none; }
        .table-link {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 22px 18px;
            min-height: 48px;
            text-decoration: none;
            color: #0f172a;
            font-size: 1.3rem;
            font-weight: bold;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
            transition: transform 0.15s ease-out, border-color 0.15s ease-out;
        }
        .table-link:hover {
            transform: translateY(-2px);
            border-color: #93c5fd;
        }
        .alert {
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #991b1b;
            background-color: #fee2e2;
            border: 1px solid #fca5a5;
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 16px;
            box-shadow: 0 2px 8px rgba(220, 38, 38, 0.12);
        }
        #offline {
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #92400e;
            background-color: #fef3c7;
            border: 1px solid #fcd34d;
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 16px;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.15);
        }
        .badge-new {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #ef4444;
            border-radius: 20px;
            padding: 5px 13px;
            margin-left: 8px;
            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
        }
        .badge-cooking {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #b45309;
            border-radius: 20px;
            padding: 5px 13px;
            margin-left: 8px;
        }
        .badge-ready {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border-radius: 20px;
            padding: 5px 13px;
            margin-left: 8px;
            box-shadow: 0 2px 6px rgba(22, 163, 74, 0.4);
        }
        .badge-cancelled {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #64748b;
            border-radius: 20px;
            padding: 5px 13px;
            margin-left: 8px;
        }
        .wait { font-size: 0.95rem; color: #64748b; }
        .wait-over { color: #dc2626; font-weight: bold; }
        .empty-state {
            text-align: center;
            color: #64748b;
            font-size: 1.2rem;
            padding: 56px 16px;
            background-color: #ffffff;
            border: 2px dashed #cbd5e1;
            border-radius: 16px;
        }
        .empty-state small {
            display: block;
            margin-top: 8px;
            font-size: 1rem;
            color: #64748b;
        }
        .card-grid.status-table-list { grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
        .status-table-card { min-width: 0; }
        .status-table-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }
        .status-table-heading .table-name { margin: 0; }
        .status-table-open-count { color: #526257; font-size: 0.85rem; font-weight: 600; }
        .table-status-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 16px;
        }
        .table-status-summary button {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 34px;
            padding: 5px 10px;
            border: 1px solid transparent;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
        }
        .table-status-summary button span { font-variant-numeric: tabular-nums; }
        .table-status-summary .ordered { border-color: #f3dfa0; color: #92400e; background: #fef3c7; }
        .table-status-summary .cooking { border-color: #fed7aa; color: #9a3412; background: #ffedd5; }
        .table-status-summary .ready { border-color: #bae6fd; color: #075985; background: #e0f2fe; }
        .table-status-summary button:hover { filter: brightness(0.96); }
        .status-group { scroll-margin-top: 16px; }
        .status-group + .status-group { margin-top: 18px; }
        .status-group-title {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 12px;
            margin: 0 0 8px;
            padding-bottom: 7px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
            font-size: 1rem;
        }
        .status-history-group {
            padding-top: 12px;
            border-top: 1px solid #e6ece7;
        }
        .status-history-group > summary { cursor: pointer; list-style: none; }
        .status-history-group > summary::-webkit-details-marker { display: none; }
        .status-history-group > summary::before {
            width: 7px;
            height: 7px;
            flex: 0 0 7px;
            margin: 0 4px 0 2px;
            border-right: 2px solid currentColor;
            border-bottom: 2px solid currentColor;
            content: "";
            transform: rotate(-45deg);
        }
        .status-history-group[open] > summary::before { transform: rotate(45deg); }
        .status-history-group > summary:focus-visible {
            outline: 3px solid rgba(22, 101, 52, 0.45);
            outline-offset: 3px;
        }
        .status-history-group .status-group-title { margin-bottom: 0; }
        .status-history-group[open] .status-group-title { margin-bottom: 8px; }
        .status-group-title small { color: #64748b; font-size: 0.85rem; }
        .status-group-items { display: grid; gap: 10px; }
        .status-dish-card { min-width: 0; padding: 12px 0; border-bottom: 1px solid #edf1ee; }
        .status-dish-card:last-child { border-bottom: 0; }
        .status-dish-title {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }
        .status-dish-title strong { min-width: 0; overflow-wrap: anywhere; }
        .status-dish-content .wait { display: block; margin-top: 8px; }
        .status-dish-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
        }
        .status-dish-actions form { margin: 0; }
        .status-dish-actions button { min-height: 42px; }
        #status-feedback {
            margin-bottom: 14px;
            padding: 10px 12px;
            border: 1px solid #efc4c1;
            border-radius: 6px;
            color: #7f1d1d;
            background: #fff1f0;
            font-size: 0.9rem;
        }
        @media (max-width: 520px) {
            .status-dish-title { flex-direction: column; gap: 6px; }
            .status-dish-actions { display: grid; grid-template-columns: 1fr; }
            .status-dish-actions form,
            .status-dish-actions button { width: 100%; }
        }
        /* โฟกัสคีย์บอร์ดต้องเห็นชัด + เคารพ reduced motion */
        a:focus-visible, button:focus-visible {
            outline: 3px solid #2563eb;
            outline-offset: 2px;
        }
        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; }
        }
    </style>
    <link rel="stylesheet" href="/css/staff.css">
</head>
<body class="staff-ui staff-kitchen">

<nav class="sidebar">
    <a class="staff-brand-link" href="/kitchen">ไอทีม่วนแจ่ม <span>STAFF</span></a>
    <a href="/kitchen" class="<%= page === 'kitchen' ? 'active' : '' %>">ดูรายละเอียด</a>
    <a href="/kitchen/orders" class="<%= page === 'orders' ? 'active' : '' %>">ออเดอร์ที่ต้องทำ</a>
    <a href="/kitchen/status" class="<%= page === 'status' ? 'active' : '' %>">อัพเดทสถานะ</a>
</nav>
<div class="kitchen-container">
    <header class="kitchen-header">
        <h1><%= title %></h1>
        <% if (mode === 'kitchen' || mode === 'server') { %>
            <p class="count-line">ทั้งหมด <%= bills.length %> บิล</p>
        <% } else if (mode === 'ordered') { %>
            <p class="count-line">ทั้งหมด <%= dishes.length %> จาน</p>
        <% } else if (mode === 'status') { %>
            <p class="count-line">ทั้งหมด <%= dishes.length %> รายการอาหาร</p>
        <% } else { %>
            <p class="count-line">ทั้งหมด <%= tables.length %> โต๊ะ</p>
        <% } %>
    </header>

    <main id="content">
        <% if (mode === 'status') { %>
            <div id="status-feedback" role="status" aria-live="polite" hidden></div>
        <% } %>
        <% const isServer = (mode === 'server'); %>
        <% if (msg === 'taken') { %>
            <div class="alert">มีคนรับรายการนี้ไปแล้ว</div>
        <% } else if (msg === 'invalid') { %>
            <div class="alert">ข้อมูลไม่ถูกต้อง</div>
        <% } else if (msg === 'changed') { %>
            <div class="alert">สถานะรายการเปลี่ยนไปแล้ว</div>
        <% } %>

        <% if (mode === 'kitchen' || mode === 'server') { %>
            <% if (bills.length > 0) { %>
                <div class="card-grid">
                    <% bills.forEach(function(b, i) { %>
                        <section class="order-card<%= b.action === 'accept' ? ' acc-new' : '' %><%= b.action === 'update' ? ' acc-cook' : '' %><%= b.action === 'serve' ? ' acc-serve' : '' %><%= b.action === 'none' ? ' cancelled' : '' %>">
                            <div class="card-head">
                                <span class="table-name">โต๊ะ <%= b.table_number %><% if (b.hasNew) { %><span class="badge-new">ใหม่</span><% } %><% if (b.action === 'update') { %><span class="badge-cooking">กำลังปรุง</span><% } %><% if (b.action === 'serve') { %><span class="badge-ready">พร้อมเสิร์ฟ</span><% } %><% if (b.action === 'none') { %><span class="badge-cancelled">ยกเลิกแล้ว</span><% } %></span>
                                <span class="bill-meta">
                                    <span class="order-time"><%= b.firstTimeTh %> น. <span class="wait<%= b.maxWait > 10 ? ' wait-over' : '' %>">(รอ <%= b.maxWait %> นาที)</span></span>
                                    <span class="bill-sequence">#<%= bills.length - i %></span>
                                </span>
                            </div>
                            <% b.items.forEach(function(item) { %>
                                <div class="dish">
                                    <div class="dish-row-line">
                                        <span><%= item.qty %>× <%= item.name %></span>
                                        <span><%= item.lineTotal.toLocaleString() %></span>
                                    </div>
                                    <% if (item.note) { %>
                                        <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                                    <% } %>
                                    <% if (isServer && b.action === 'serve') { %>
                                        <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="return busySubmit(this, 'กำลังบันทึก...');">
                                            <input type="hidden" name="to" value="served">
                                            <input type="hidden" name="table_id" value="<%= b.table_id %>">
                                            <input type="hidden" name="back" value="/orders">
                                            <button type="submit" class="btn-serve">เสิร์ฟแล้ว</button>
                                        </form>
                                    <% } %>
                                </div>
                            <% }); %>
                            <% if (b.action === 'none') { %>
                                <span class="cancel-note">ยกเลิกแล้ว: <%= b.items[0].cancel_reason %></span>
                            <% } %>
                            <div class="bill-total"><span>รวม</span><span>฿<%= b.total.toLocaleString() %></span></div>
                            <% if (!isServer && b.action === 'accept') { %>
                                <form method="POST" action="/kitchen/accept" onsubmit="return busySubmit(this, 'กำลังรับ...');">
                                    <input type="hidden" name="ids" value="<%= b.ids %>">
                                    <button type="submit" class="btn-accept">รับรายการอาหาร</button>
                                </form>
                            <% } %>
                            <% if (!isServer && b.action === 'update') { %>
                                <a class="btn-link" href="/kitchen/table/<%= b.table_id %>?from=kitchen">อัพเดทสถานะ</a>
                            <% } %>
                            <% if (isServer && b.action !== 'none') { %>
                                <a class="btn-link" href="/kitchen/table/<%= b.table_id %>?from=orders">ดูรายละเอียด</a>
                            <% } %>
                        </section>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีออเดอร์ใหม่<small>รีเฟรชหน้านี้เพื่อตรวจสอบออร์เดอร์ล่าสุด</small></div>
            <% } %>
        <% } %>

        <% if (mode === 'ordered') { %>
            <% if (dishes.length > 0) { %>
                <div class="card-grid">
                    <% dishes.forEach(function(d) { %>
                        <section class="order-card">
                            <div class="card-head">
                                <span class="table-name">ออร์เดอร์ #<%= d.order_item_id %> · โต๊ะ <%= d.table_number %></span>
                                <span class="order-time"><%= d.timeTh %> น.</span>
                            </div>
                            <div class="dish">
                                <span><%= d.qty %>× <%= d.name %></span>
                                <% if (d.note) { %>
                                    <span class="dish-note">หมายเหตุ: <%= d.note %></span>
                                <% } %>
                            </div>
                            <form method="POST" action="/kitchen/item/<%= d.order_item_id %>/status" onsubmit="return busySubmit(this, 'กำลังบันทึก...');">
                                <input type="hidden" name="to" value="ready">
                                <input type="hidden" name="table_id" value="<%= d.table_id %>">
                                <input type="hidden" name="back" value="/kitchen/ordered">
                                <button type="submit" class="btn-done">ปรุงอาหารเสร็จแล้ว</button>
                            </form>
                        </section>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีออเดอร์ที่ต้องทำ<small>จานที่กดรับแล้วจะมาอยู่ที่นี่</small></div>
            <% } %>
        <% } %>

        <% if (mode === 'status') { %>
            <% if (tableGroups.length > 0) { %>
                <p class="status-scroll-hint">ปัดหรือเลื่อนซ้าย–ขวาเพื่อดูโต๊ะอื่น</p>
                <div class="card-grid status-table-list" aria-label="รายการสถานะแยกตามโต๊ะ">
                    <% tableGroups.forEach(function(tableGroup) { %>
                        <% const statusMeta = {
                            ordered: { label: 'รอรับ', className: 'ordered' },
                            cooking: { label: 'กำลังปรุง', className: 'cooking' },
                            ready: { label: 'พร้อมเสิร์ฟ', className: 'ready' },
                            served: { label: 'เสิร์ฟแล้ว', className: 'served' },
                            cancelled: { label: 'ยกเลิกแล้ว', className: 'cancelled' }
                        }; %>
                        <% const activeItems = tableGroup.items.filter(function(item) { return ['ordered', 'cooking', 'ready'].includes(item.status); }).length; %>
                        <section class="order-card status-table-card" id="table-status-<%= tableGroup.table_id %>">
                            <div class="status-table-heading">
                                <h2 class="table-name">โต๊ะ <%= tableGroup.table_number %></h2>
                                <span class="status-table-open-count"><%= activeItems %> รายการที่ยังไม่เสร็จ</span>
                            </div>
                            <nav class="table-status-summary" aria-label="สรุปสถานะโต๊ะ <%= tableGroup.table_number %>">
                                <% ['ordered', 'cooking', 'ready'].forEach(function(statusKey) {
                                    const status = statusMeta[statusKey];
                                    const count = tableGroup.items.filter(function(item) { return item.status === statusKey; }).length;
                                %>
                                    <% if (count > 0) { %>
                                        <button type="button" class="<%= status.className %>" data-scroll-target="table-<%= tableGroup.table_id %>-<%= statusKey %>">
                                            <%= status.label %><span><%= count %></span>
                                        </button>
                                    <% } %>
                                <% }); %>
                            </nav>
                            <% ['ordered', 'cooking', 'ready', 'served', 'cancelled'].forEach(function(statusKey) {
                                const status = statusMeta[statusKey];
                                const statusItems = tableGroup.items.filter(function(item) { return item.status === statusKey; });
                            %>
                                <% if (statusItems.length > 0) { %>
                                    <% if (['served', 'cancelled'].includes(statusKey)) { %>
                                    <details class="status-group status-history-group status-<%= statusKey %>">
                                        <summary class="status-group-title">
                                            <span><%= status.label %></span>
                                            <small><%= statusItems.length %> รายการ · แตะเพื่อดู</small>
                                        </summary>
                                    <% } else { %>
                                    <section class="status-group status-<%= statusKey %>" id="table-<%= tableGroup.table_id %>-<%= statusKey %>">
                                        <h3 class="status-group-title">
                                            <span><%= status.label %></span>
                                            <small><%= statusItems.length %> รายการ</small>
                                        </h3>
                                    <% } %>
                                        <div class="status-group-items">
                                            <% statusItems.forEach(function(dish) { %>
                                                <article class="status-dish-card">
                                                    <div class="card-head">
                                                        <span class="order-time"><%= dish.timeTh %> น.</span>
                                                        <span class="status-order-ref">#<%= dish.order_item_id %></span>
                                                    </div>
                                                    <div class="dish status-dish-content">
                                                        <div class="status-dish-title">
                                                            <strong><%= dish.qty %>× <%= dish.name %></strong>
                                                        </div>
                                                        <% if (dish.note) { %>
                                                            <span class="dish-note">หมายเหตุ: <%= dish.note %></span>
                                                        <% } %>
                                                        <% if (dish.status === 'cancelled' && dish.cancel_reason) { %>
                                                            <span class="cancel-note">เหตุผลที่ยกเลิก: <%= dish.cancel_reason %></span>
                                                        <% } %>
                                                        <% if (['ordered', 'cooking', 'ready'].includes(dish.status)) { %>
                                                            <span class="wait<%= dish.waitMin > 10 ? ' wait-over' : '' %>">รอ <%= dish.waitMin %> นาที</span>
                                                        <% } %>
                                                    </div>
                                                    <% if (dish.status === 'cooking') { %>
                                                        <div class="status-dish-actions">
                                                            <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return busySubmit(this, 'กำลังย้อนกลับ...');">
                                                                <input type="hidden" name="to" value="ordered">
                                                                <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                <input type="hidden" name="back" value="/kitchen/status">
                                                                <button type="submit" class="btn-back-step">ย้อนกลับไปรอรับ</button>
                                                            </form>
                                                            <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return askReason(this);">
                                                                <input type="hidden" name="to" value="cancelled">
                                                                <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                <input type="hidden" name="back" value="/kitchen/status">
                                                                <input type="hidden" name="reason" value="">
                                                                <button type="submit" class="btn-cancel">ยกเลิก</button>
                                                            </form>
                                                        </div>
                                                    <% } else if (dish.status === 'ready') { %>
                                                        <div class="status-dish-actions">
                                                            <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return busySubmit(this, 'กำลังบันทึก...');">
                                                                <input type="hidden" name="to" value="served">
                                                                <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                <input type="hidden" name="back" value="/kitchen/status">
                                                                <button type="submit" class="btn-serve">เสิร์ฟแล้ว</button>
                                                            </form>
                                                            <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return busySubmit(this, 'กำลังย้อนกลับ...');">
                                                                <input type="hidden" name="to" value="cooking">
                                                                <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                <input type="hidden" name="back" value="/kitchen/status">
                                                                <button type="submit" class="btn-back-step">ย้อนกลับไปกำลังปรุง</button>
                                                            </form>
                                                        </div>
                                                    <% } %>
                                                </article>
                                            <% }); %>
                                        </div>
                                    <% if (['served', 'cancelled'].includes(statusKey)) { %>
                                    </details>
                                    <% } else { %>
                                    </section>
                                    <% } %>
                                <% } %>
                            <% }); %>
                        </section>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีรายการอาหารให้แสดง</div>
            <% } %>
        <% } %>

        <% if (mode === 'tables') { %>
            <% if (tables.length > 0) { %>
                <div class="card-grid">
                    <% tables.forEach(function(t) { %>
                        <a class="table-link" href="/kitchen/table/<%= t.table_id %>?from=status">
                            <span>โต๊ะ <%= t.table_number %></span>
                            <span>สั่ง <%= t.total %> รายการ<% if (t.cancelled > 0) { %> · ยกเลิก <%= t.cancelled %> รายการ<% } %></span>
                        </a>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีโต๊ะที่ต้องอัพเดท<small>โต๊ะที่มีงานค้างจะขึ้นที่นี่ กดเพื่อดูรายจาน</small></div>
            <% } %>
        <% } %>
    </main>
</div>
<script>
    // กดปุ่มแล้วล็อกกันกดซ้ำ + เปลี่ยนข้อความว่ากำลังทำ
    function busySubmit(f, text) {
        const b = f.querySelector('[type=submit]');
        if (b) {
            b.dataset.idleLabel = b.dataset.idleLabel || b.textContent;
            b.disabled = true;
            b.textContent = text;
        }
        return true;
    }
        function askReason(f) {
            const reason = prompt('เหตุผลที่ยกเลิก:');
            if (!reason || !reason.trim()) return false;
            f.reason.value = reason.trim();
            return busySubmit(f, 'กำลังยกเลิก...');
        }
    async function refreshStatusView(tableCardId, previousTop) {
        const response = await fetch(window.location.pathname + window.location.search, {
            headers: { Accept: 'text/html' }
        });
        if (!response.ok) throw new Error('บันทึกแล้ว แต่โหลดรายการล่าสุดไม่สำเร็จ กรุณารีเฟรชหน้า');
        const html = await response.text();
        const nextDocument = new DOMParser().parseFromString(html, 'text/html');
        const currentMain = document.getElementById('content');
        const nextMain = nextDocument.getElementById('content');
        if (!currentMain || !nextMain) throw new Error('บันทึกแล้ว แต่โหลดรายการล่าสุดไม่สำเร็จ กรุณารีเฟรชหน้า');

        currentMain.replaceWith(nextMain);
        const nextCountLine = nextDocument.querySelector('.kitchen-header .count-line');
        const currentCountLine = document.querySelector('.kitchen-header .count-line');
        if (nextCountLine && currentCountLine) currentCountLine.replaceWith(nextCountLine);
        if (tableCardId && previousTop !== null) {
            const refreshedCard = document.getElementById(tableCardId);
            if (refreshedCard) window.scrollBy(0, refreshedCard.getBoundingClientRect().top - previousTop);
        }
        return document.getElementById('status-feedback');
    }
    document.addEventListener('click', function (event) {
        const button = event.target.closest('[data-scroll-target]');
        if (!button) return;
        const section = document.getElementById(button.dataset.scrollTarget);
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.addEventListener('submit', async function (event) {
        const form = event.target.closest('form[data-async-status]');
        if (!form) return;
        event.preventDefault();

        const button = form.querySelector('[type=submit]');
        const idleLabel = button ? (button.dataset.idleLabel || button.textContent) : '';
        const tableCard = form.closest('.status-table-card');
        const tableCardId = tableCard ? tableCard.id : '';
        const previousTop = tableCard ? tableCard.getBoundingClientRect().top : null;

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new URLSearchParams(new FormData(form)),
                headers: { Accept: 'application/json' }
            });
            const result = await response.json();
            if (!response.ok) {
                if (response.status === 409) {
                    const feedback = await refreshStatusView(tableCardId, previousTop);
                    if (feedback) {
                        feedback.textContent = 'รายการนี้ถูกเปลี่ยนสถานะไปแล้ว ข้อมูลล่าสุดถูกโหลดแล้ว';
                        feedback.hidden = false;
                    }
                    return;
                }
                const messages = {
                    invalid: 'ข้อมูลไม่ถูกต้อง กรุณาตรวจสอบแล้วลองอีกครั้ง'
                };
                throw new Error(messages[result.error] || 'บันทึกสถานะไม่สำเร็จ กรุณาลองอีกครั้ง');
            }

            await refreshStatusView(tableCardId, previousTop);
        } catch (error) {
            if (button) {
                button.disabled = false;
                button.textContent = idleLabel;
            }
            const feedback = document.getElementById('status-feedback');
            if (feedback) {
                feedback.textContent = error.message;
                feedback.hidden = false;
            } else {
                alert(error.message);
            }
        }
    });
    (function () {
        const p = new URLSearchParams(location.search);
        if (p.has('msg')) {
            p.delete('msg');
            const q = p.toString();
            history.replaceState(null, '', location.pathname + (q ? '?' + q : ''));
        }
    })();
</script>
</body>
</html>
