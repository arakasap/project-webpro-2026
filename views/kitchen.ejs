<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/kitchen-shared.css">
    <link rel="stylesheet" href="/css/kitchen.css">
    <link rel="stylesheet" href="/css/staff.css">
</head>
<% const isLoginRequired = typeof loginRequired !== 'undefined' && loginRequired; %>
<body class="staff-ui staff-kitchen<%= isLoginRequired ? ' kitchen-auth-required' : '' %>">

<% if (isLoginRequired) { %>
    <dialog class="kitchen-login-modal" id="kitchen-login-modal" data-auto-open="true" aria-labelledby="kitchen-login-title">
        <h2 id="kitchen-login-title">เข้าสู่หน้าครัว</h2>
        <p class="kitchen-login-intro">กรอกรหัสพนักงานเพื่อดำเนินการต่อ</p>
        <% if (loginError) { %>
            <p class="kitchen-login-error" role="alert"><%= loginError %></p>
        <% } %>
        <form method="POST" action="/kitchen/login">
            <label for="kitchen-login-password">รหัสพนักงาน</label>
            <input
                id="kitchen-login-password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                autofocus
            >
            <button type="submit">เข้าสู่ระบบ</button>
        </form>
    </dialog>
<% } %>

<nav class="sidebar">
    <a class="staff-brand-link" href="<%= staffRole === 'serve' ? '/orders' : '/kitchen' %>">ไอทีม่วนแจ่ม <span>STAFF</span></a>
    <a href="<%= staffRole === 'serve' ? '/orders' : '/kitchen' %>" class="<%= page === 'kitchen' || (staffRole === 'serve' && mode === 'server') ? 'active' : '' %>">ดูรายละเอียด</a>
    <% if (staffRole === 'kitchen') { %>
        <a href="/kitchen/orders" class="<%= page === 'orders' ? 'active' : '' %>">ออเดอร์ที่ต้องทำ</a>
    <% } %>
    <a href="/kitchen/status" class="<%= page === 'status' ? 'active' : '' %>">อัพเดทสถานะ</a>
    <form class="staff-logout-form" method="POST" action="/kitchen/logout">
        <button class="staff-logout" type="submit">ออกจากระบบ</button>
    </form>
</nav>
<div class="kitchen-container">
    <header class="kitchen-header">
        <h1><%= title %></h1>
        <% if (mode === 'kitchen' || mode === 'server') { %>
            <p class="count-line">ทั้งหมด <%= bills.length %> บิล</p>
        <% } else if (mode === 'ordered') { %>
            <p class="count-line">ทั้งหมด <%= dishes.length %> จาน</p>
        <% } else if (mode === 'status') { %>
            <p class="count-line">ทั้งหมด <%= dishes.length %> รายการอาหาร</p>
        <% } else { %>
            <p class="count-line">ทั้งหมด <%= tables.length %> โต๊ะ</p>
        <% } %>
    </header>

    <main id="content">
        <% if (mode === 'status') { %>
            <div id="status-feedback" role="status" aria-live="polite" hidden></div>
        <% } %>
        <% if (msg === 'taken') { %>
            <div class="alert">มีคนรับรายการนี้ไปแล้ว</div>
        <% } else if (msg === 'invalid') { %>
            <div class="alert">ข้อมูลไม่ถูกต้อง</div>
        <% } else if (msg === 'changed') { %>
            <div class="alert">สถานะรายการเปลี่ยนไปแล้ว</div>
        <% } else if (msg === 'forbidden') { %>
            <div class="alert">บัญชีนี้ไม่มีสิทธิ์ทำรายการดังกล่าว</div>
        <% } %>

        <% if (mode === 'kitchen' || mode === 'server') { %>
            <% if (bills.length > 0) { %>
                <div class="card-grid">
                    <% bills.forEach(function(b, i) { %>
                        <section class="order-card<%= b.action === 'accept' ? ' acc-new' : '' %><%= b.action === 'update' ? ' acc-cook' : '' %><%= b.action === 'serve' ? ' acc-serve' : '' %><%= b.action === 'none' ? ' cancelled' : '' %>">
                            <div class="card-head">
                                <span class="table-name">โต๊ะ <%= b.table_number %><% if (b.hasNew) { %><span class="badge-new">ใหม่</span><% } %><% if (b.action === 'update') { %><span class="badge-cooking">กำลังปรุง</span><% } %><% if (b.action === 'serve') { %><span class="badge-ready">พร้อมเสิร์ฟ</span><% } %><% if (b.action === 'none') { %><span class="badge-cancelled">ยกเลิกแล้ว</span><% } %></span>
                                <span class="bill-meta">
                                    <span class="order-time"><%= b.firstTimeTh %> น. <span class="wait<%= b.maxWait > 10 ? ' wait-over' : '' %>">(รอ <%= b.maxWait %> นาที)</span></span>
                                    <span class="bill-sequence">#<%= bills.length - i %></span>
                                </span>
                            </div>
                            <% b.items.forEach(function(item) { %>
                                <div class="dish">
                                    <div class="dish-row-line">
                                        <span><%= item.qty %>× <%= item.name %></span>
                                        <span><%= item.lineTotal.toLocaleString() %></span>
                                    </div>
                                    <% if (item.note) { %>
                                        <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                                    <% } %>
                                    <% if (staffRole === 'serve' && b.action === 'serve') { %>
                                        <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="return busySubmit(this, 'กำลังบันทึก...');">
                                            <input type="hidden" name="to" value="served">
                                            <input type="hidden" name="table_id" value="<%= b.table_id %>">
                                            <input type="hidden" name="back" value="/orders">
                                            <button type="submit" class="btn-serve">เสิร์ฟแล้ว</button>
                                        </form>
                                    <% } %>
                                </div>
                            <% }); %>
                            <% if (b.action === 'none') { %>
                                <span class="cancel-note">ยกเลิกแล้ว: <%= b.items[0].cancel_reason %></span>
                            <% } %>
                            <div class="bill-total"><span>รวม</span><span>฿<%= b.total.toLocaleString() %></span></div>
                            <% if (staffRole === 'kitchen' && b.action === 'accept') { %>
                                <form method="POST" action="/kitchen/accept" onsubmit="return busySubmit(this, 'กำลังรับ...');">
                                    <input type="hidden" name="ids" value="<%= b.ids %>">
                                    <button type="submit" class="btn-accept">รับรายการอาหาร</button>
                                </form>
                            <% } %>
                            <% if (b.action !== 'none' && (staffRole === 'serve' || b.action !== 'accept')) { %>
                                <a class="btn-link" href="/kitchen/table/<%= b.table_id %>?from=<%= mode === 'server' ? 'orders' : 'kitchen' %>">ดูรายละเอียด</a>
                            <% } %>
                        </section>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีออเดอร์ใหม่<small>รีเฟรชหน้านี้เพื่อตรวจสอบออร์เดอร์ล่าสุด</small></div>
            <% } %>
        <% } %>

        <% if (mode === 'ordered') { %>
            <% if (dishes.length > 0) { %>
                <div class="card-grid">
                    <% dishes.forEach(function(d) { %>
                        <section class="order-card">
                            <div class="card-head">
                                <span class="table-name">ออร์เดอร์ #<%= d.order_item_id %> · โต๊ะ <%= d.table_number %></span>
                                <span class="order-time"><%= d.timeTh %> น.</span>
                            </div>
                            <div class="dish">
                                <span><%= d.qty %>× <%= d.name %></span>
                                <% if (d.note) { %>
                                    <span class="dish-note">หมายเหตุ: <%= d.note %></span>
                                <% } %>
                            </div>
                            <form method="POST" action="/kitchen/item/<%= d.order_item_id %>/status" onsubmit="return busySubmit(this, 'กำลังบันทึก...');">
                                <input type="hidden" name="to" value="ready">
                                <input type="hidden" name="table_id" value="<%= d.table_id %>">
                                <input type="hidden" name="back" value="/kitchen/ordered">
                                <button type="submit" class="btn-done">ปรุงอาหารเสร็จแล้ว</button>
                            </form>
                        </section>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีออเดอร์ที่ต้องทำ<small>จานที่กดรับแล้วจะมาอยู่ที่นี่</small></div>
            <% } %>
        <% } %>

        <% if (mode === 'status') { %>
            <% if (tableGroups.length > 0) { %>
                <p class="status-scroll-hint">ปัดหรือเลื่อนซ้าย–ขวาเพื่อดูโต๊ะอื่น</p>
                <div class="card-grid status-table-list" aria-label="รายการสถานะแยกตามโต๊ะ">
                    <% tableGroups.forEach(function(tableGroup) { %>
                        <% const statusMeta = {
                            ordered: { label: 'รอรับ', className: 'ordered' },
                            cooking: { label: 'กำลังปรุง', className: 'cooking' },
                            ready: { label: 'พร้อมเสิร์ฟ', className: 'ready' },
                            served: { label: 'เสิร์ฟแล้ว', className: 'served' },
                            cancelled: { label: 'ยกเลิกแล้ว', className: 'cancelled' }
                        }; %>
                        <% const activeItems = tableGroup.items.filter(function(item) { return ['ordered', 'cooking', 'ready'].includes(item.status); }).length; %>
                        <section class="order-card status-table-card" id="table-status-<%= tableGroup.table_id %>">
                            <div class="status-table-heading">
                                <h2 class="table-name">โต๊ะ <%= tableGroup.table_number %></h2>
                                <span class="status-table-open-count"><%= activeItems %> รายการที่ยังไม่เสร็จ</span>
                            </div>
                            <nav class="table-status-summary" aria-label="สรุปสถานะโต๊ะ <%= tableGroup.table_number %>">
                                <% ['ordered', 'cooking', 'ready'].forEach(function(statusKey) {
                                    const status = statusMeta[statusKey];
                                    const count = tableGroup.items.filter(function(item) { return item.status === statusKey; }).length;
                                %>
                                    <% if (count > 0) { %>
                                        <button type="button" class="<%= status.className %>" data-scroll-target="table-<%= tableGroup.table_id %>-<%= statusKey %>">
                                            <%= status.label %><span><%= count %></span>
                                        </button>
                                    <% } %>
                                <% }); %>
                            </nav>
                            <% ['ordered', 'cooking', 'ready', 'served', 'cancelled'].forEach(function(statusKey) {
                                const status = statusMeta[statusKey];
                                const statusItems = tableGroup.items.filter(function(item) { return item.status === statusKey; });
                            %>
                                <% if (statusItems.length > 0) { %>
                                    <% if (['served', 'cancelled'].includes(statusKey)) { %>
                                    <details class="status-group status-history-group status-<%= statusKey %>">
                                        <summary class="status-group-title">
                                            <span><%= status.label %></span>
                                            <small><%= statusItems.length %> รายการ · แตะเพื่อดู</small>
                                        </summary>
                                    <% } else { %>
                                    <section class="status-group status-<%= statusKey %>" id="table-<%= tableGroup.table_id %>-<%= statusKey %>">
                                        <h3 class="status-group-title">
                                            <span><%= status.label %></span>
                                            <small><%= statusItems.length %> รายการ</small>
                                        </h3>
                                    <% } %>
                                        <div class="status-group-items">
                                            <% statusItems.forEach(function(dish) { %>
                                                <article class="status-dish-card">
                                                    <div class="card-head">
                                                        <span class="order-time"><%= dish.timeTh %> น.</span>
                                                        <span class="status-order-ref">#<%= dish.order_item_id %></span>
                                                    </div>
                                                    <div class="dish status-dish-content">
                                                        <div class="status-dish-title">
                                                            <strong><%= dish.qty %>× <%= dish.name %></strong>
                                                        </div>
                                                        <% if (dish.note) { %>
                                                            <span class="dish-note">หมายเหตุ: <%= dish.note %></span>
                                                        <% } %>
                                                        <% if (dish.status === 'cancelled' && dish.cancel_reason) { %>
                                                            <span class="cancel-note">เหตุผลที่ยกเลิก: <%= dish.cancel_reason %></span>
                                                        <% } %>
                                                        <% if (['ordered', 'cooking', 'ready'].includes(dish.status)) { %>
                                                            <span class="wait<%= dish.waitMin > 10 ? ' wait-over' : '' %>">รอ <%= dish.waitMin %> นาที</span>
                                                        <% } %>
                                                    </div>
                                                    <% if (staffRole === 'kitchen' && dish.status === 'cooking') { %>
                                                        <div class="status-dish-actions">
                                                            <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return busySubmit(this, 'กำลังย้อนกลับ...');">
                                                                <input type="hidden" name="to" value="ordered">
                                                                <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                <input type="hidden" name="back" value="/kitchen/status">
                                                                <button type="submit" class="btn-back-step">ย้อนกลับไปรอรับ</button>
                                                            </form>
                                                            <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return askReason(this);">
                                                                <input type="hidden" name="to" value="cancelled">
                                                                <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                <input type="hidden" name="back" value="/kitchen/status">
                                                                <input type="hidden" name="reason" value="">
                                                                <button type="submit" class="btn-cancel">ยกเลิก</button>
                                                            </form>
                                                        </div>
                                                    <% } else if (dish.status === 'ready') { %>
                                                        <div class="status-dish-actions">
                                                            <% if (staffRole === 'serve') { %>
                                                                <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return busySubmit(this, 'กำลังบันทึก...');">
                                                                    <input type="hidden" name="to" value="served">
                                                                    <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                    <input type="hidden" name="back" value="/kitchen/status">
                                                                    <button type="submit" class="btn-serve">เสิร์ฟแล้ว</button>
                                                                </form>
                                                            <% } else { %>
                                                                <form method="POST" action="/kitchen/item/<%= dish.order_item_id %>/status" data-async-status onsubmit="return busySubmit(this, 'กำลังย้อนกลับ...');">
                                                                    <input type="hidden" name="to" value="cooking">
                                                                    <input type="hidden" name="table_id" value="<%= dish.table_id %>">
                                                                    <input type="hidden" name="back" value="/kitchen/status">
                                                                    <button type="submit" class="btn-back-step">ย้อนกลับไปกำลังปรุง</button>
                                                                </form>
                                                            <% } %>
                                                        </div>
                                                    <% } %>
                                                </article>
                                            <% }); %>
                                        </div>
                                    <% if (['served', 'cancelled'].includes(statusKey)) { %>
                                    </details>
                                    <% } else { %>
                                    </section>
                                    <% } %>
                                <% } %>
                            <% }); %>
                        </section>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีรายการอาหารให้แสดง</div>
            <% } %>
        <% } %>

        <% if (mode === 'tables') { %>
            <% if (tables.length > 0) { %>
                <div class="card-grid">
                    <% tables.forEach(function(t) { %>
                        <a class="table-link" href="/kitchen/table/<%= t.table_id %>?from=status">
                            <span>โต๊ะ <%= t.table_number %></span>
                            <span>สั่ง <%= t.total %> รายการ<% if (t.cancelled > 0) { %> · ยกเลิก <%= t.cancelled %> รายการ<% } %></span>
                        </a>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">ไม่มีโต๊ะที่ต้องอัพเดท<small>โต๊ะที่มีงานค้างจะขึ้นที่นี่ กดเพื่อดูรายจาน</small></div>
            <% } %>
        <% } %>
    </main>
</div>
<script>
    // กดปุ่มแล้วล็อกกันกดซ้ำ + เปลี่ยนข้อความว่ากำลังทำ
    function busySubmit(f, text) {
        const b = f.querySelector('[type=submit]');
        if (b) {
            b.dataset.idleLabel = b.dataset.idleLabel || b.textContent;
            b.disabled = true;
            b.textContent = text;
        }
        return true;
    }
        function askReason(f) {
            const reason = prompt('เหตุผลที่ยกเลิก:');
            if (!reason || !reason.trim()) return false;
            f.reason.value = reason.trim();
            return busySubmit(f, 'กำลังยกเลิก...');
        }
    async function refreshStatusView(tableCardId, previousTop) {
        const response = await fetch(window.location.pathname + window.location.search, {
            headers: { Accept: 'text/html' }
        });
        if (!response.ok) throw new Error('บันทึกแล้ว แต่โหลดรายการล่าสุดไม่สำเร็จ กรุณารีเฟรชหน้า');
        const html = await response.text();
        const nextDocument = new DOMParser().parseFromString(html, 'text/html');
        const currentMain = document.getElementById('content');
        const nextMain = nextDocument.getElementById('content');
        if (!currentMain || !nextMain) throw new Error('บันทึกแล้ว แต่โหลดรายการล่าสุดไม่สำเร็จ กรุณารีเฟรชหน้า');

        currentMain.replaceWith(nextMain);
        const nextCountLine = nextDocument.querySelector('.kitchen-header .count-line');
        const currentCountLine = document.querySelector('.kitchen-header .count-line');
        if (nextCountLine && currentCountLine) currentCountLine.replaceWith(nextCountLine);
        if (tableCardId && previousTop !== null) {
            const refreshedCard = document.getElementById(tableCardId);
            if (refreshedCard) window.scrollBy(0, refreshedCard.getBoundingClientRect().top - previousTop);
        }
        return document.getElementById('status-feedback');
    }
    document.addEventListener('click', function (event) {
        const button = event.target.closest('[data-scroll-target]');
        if (!button) return;
        const section = document.getElementById(button.dataset.scrollTarget);
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.addEventListener('submit', async function (event) {
        const form = event.target.closest('form[data-async-status]');
        if (!form) return;
        event.preventDefault();

        const button = form.querySelector('[type=submit]');
        const idleLabel = button ? (button.dataset.idleLabel || button.textContent) : '';
        const tableCard = form.closest('.status-table-card');
        const tableCardId = tableCard ? tableCard.id : '';
        const previousTop = tableCard ? tableCard.getBoundingClientRect().top : null;

        window.pauseLiveUpdateReload = true;
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: new URLSearchParams(new FormData(form)),
                headers: { Accept: 'application/json' }
            });
            const result = await response.json();
            if (!response.ok) {
                if (response.status === 409) {
                    const feedback = await refreshStatusView(tableCardId, previousTop);
                    if (feedback) {
                        feedback.textContent = 'รายการนี้ถูกเปลี่ยนสถานะไปแล้ว ข้อมูลล่าสุดถูกโหลดแล้ว';
                        feedback.hidden = false;
                    }
                    return;
                }
                const messages = {
                    invalid: 'ข้อมูลไม่ถูกต้อง กรุณาตรวจสอบแล้วลองอีกครั้ง'
                };
                throw new Error(messages[result.error] || 'บันทึกสถานะไม่สำเร็จ กรุณาลองอีกครั้ง');
            }

            await refreshStatusView(tableCardId, previousTop);
        } catch (error) {
            if (button) {
                button.disabled = false;
                button.textContent = idleLabel;
            }
            const feedback = document.getElementById('status-feedback');
            if (feedback) {
                feedback.textContent = error.message;
                feedback.hidden = false;
            } else {
                alert(error.message);
            }
        } finally {
            window.pauseLiveUpdateReload = false;
        }
    });
    (function () {
        const p = new URLSearchParams(location.search);
        if (p.has('msg')) {
            p.delete('msg');
            const q = p.toString();
            history.replaceState(null, '', location.pathname + (q ? '?' + q : ''));
        }
    })();
</script>
    <script src="/js/live-updates.js" data-global="true"></script>
    <% if (isLoginRequired) { %>
    <script>
        const kitchenLoginModal = document.getElementById('kitchen-login-modal');
        if (kitchenLoginModal && kitchenLoginModal.dataset.autoOpen === 'true') {
            kitchenLoginModal.showModal();
        }
    </script>
    <% } %>
</body>
</html>
